datasource db {
		provider = "postgresql"
		url = env("DATABASE_URL")
}

generator client {
		provider = "prisma-client-js"
		previewFeatures = ["driverAdapters", "relationJoins"]
}

model Guild {
		id							String			@id
		name						String
		wlcChannel			String?
		ruleChannel			String?
		warnChannel			String?
		memberRole			String?
		moderatorRole		String?
		adminRole				String?
		warns						Warn[]
		ticketCategory	String?
		tickets					Ticket[]
}

model Logs {
		guildId							String @id
		messageLogStatus		Boolean
		messageLogChannel		String?
		adminLogStatus			Boolean
		adminLogChannel			String?
		memberLogStatus			Boolean
		memberLogChannel		String?
}

model Security {
		guildId							String			@id
		status							Boolean			@default(false)
		adminRoles					String?
		moderatorRoles			String?
		antiDiscordInvite		Boolean			@default(false)
}

model Warn {
		id							Int					@id @default(autoincrement())
		guild						Guild				@relation(fields: [guildId], references: [id])
		guildId					String
		memberId				String
		reason					String
		authorId				String
		time						DateTime		@default(now())
}

model Ticket {
		id							Int					@id @default(autoincrement())
		guild						Guild				@relation(fields: [guildId], references: [id])
		guildId					String			
		title						String
		authorId				String
		status					Boolean
		comment					String?
		messageId				String			@unique			// ID of the openning message 
		claimedById			String?
		startDate				DateTime		@default(now())
		closeDate				DateTime?
}


// Auth System
model Auth {
		id							Int					@id @default(autoincrement())
		token						String			// Discord token
		accessKey				String			// Application Token
		discordId				String			
}

model Hoyolab {
		discordId				String					@id @default("ERROR")
		status					Boolean
		ltoken					String					
		ltuid						String
		genshinUID			String
		hsrUID					String
		zzzUID					String
}

model RoleReaction {
		id							Int					@id @default(autoincrement())
		guildId					String
		messageId				String
		roleId					String
		reaction				String
}
